<?xml version="1.0" encoding="utf-8"?>
<!-- Окна pywebview работают на .NET Framework (pythonnet). Файлы из скачанного архива Windows
     помечает как «из интернета», и .NET отказывается загружать такие сборки (0x80131515). -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>

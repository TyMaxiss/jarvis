# Ключи API для нейросети. Скопируйте этот файл в .env (рядом с config.yaml) и впишите
# ключ того профиля, который выбран в config.yaml (llm.profile). Пробелы и кавычки не нужны.
# Файл .env не попадает в git, а ключи никогда не пишутся в лог.
# Профилю ollama ключ не нужен.

# DeepSeek (профиль deepseek): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenCode Zen (профиль opencode_zen): https://opencode.ai/zen
OPENCODE_API_KEY=

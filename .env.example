# Ключи API для нейросети. Проще всего вставить ключ в настройках программы
# (Настройки → Нейросеть) — он запишется сюда сам. Можно и вручную: скопируйте этот файл
# в .env (рядом с config.yaml) и впишите ключ выбранного профиля (llm.profile).
# Пробелы и кавычки не нужны. Файл .env не попадает в git, а ключи никогда не пишутся в лог.
# Профилю ollama ключ не нужен.

# DeepSeek (профиль deepseek): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ChatGPT (профиль openai): https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=

# Claude (профиль anthropic): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenCode Zen (профиль opencode_zen): https://opencode.ai/zen
OPENCODE_API_KEY=

# Свой OpenAI-совместимый сервис (профиль custom), если ему нужен ключ
CUSTOM_LLM_API_KEY=
